DEBUG=True
SECRET_KEY=change-this-secret-key
DJANGO_ENV=local
ENABLE_HTTPS=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# SQLite is used locally when DATABASE_URL and POSTGRES_DB are empty.
# Use PostgreSQL for production. sqlite:///db.sqlite3 is supported for local
# checks, but DEBUG=False intentionally blocks SQLite.

# Option 1: single URL
DATABASE_URL=postgresql://plataforma_user:plataforma_password@localhost:5432/plataforma_transito

# Option 2: separate variables
# POSTGRES_DB=plataforma_transito
# POSTGRES_USER=plataforma_user
# POSTGRES_PASSWORD=plataforma_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Email for activation code delivery.
# In local DEBUG=True, Django prints emails in the console unless EMAIL_BACKEND is set.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=virvalescuela@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=Escuela Virval <virvalescuela@gmail.com>
# ODO_ALERT_NOTIFICATION_EMAIL=virvalescuela@gmail.com

# Production example:
# DJANGO_ENV=production
# DEBUG=False
# ENABLE_HTTPS=True
# SECRET_KEY=replace-with-a-long-random-secret-key
# ALLOWED_HOSTS=virval.cl,www.virval.cl
# CSRF_TRUSTED_ORIGINS=https://virval.cl,https://www.virval.cl
# DATABASE_URL=postgresql://plataforma_user:plataforma_password@db-host:5432/plataforma_transito
# STATIC_ROOT=/var/www/plataforma-transito/static
# MEDIA_ROOT=/var/www/plataforma-transito/media
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=virvalescuela@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=Escuela Virval <virvalescuela@gmail.com>
# SECURE_HSTS_SECONDS=31536000

# VPS example:
# ALLOWED_HOSTS=srv1628351.hstgr.cloud,177.7.46.82
# CSRF_TRUSTED_ORIGINS=https://srv1628351.hstgr.cloud
# DATABASE_URL=postgresql://plataforma_user:plataforma_password@127.0.0.1:5432/plataforma_transito
# STATIC_ROOT=/var/www/plataforma-transito/static
# MEDIA_ROOT=/var/www/plataforma-transito/media
